+/* Browser Gamepad API buttons follow the W3C "standard" mapping for
+ * recognized USB/Bluetooth pads (DualShock, Xbox and most HID pads). Keep
+ * the fallback indices as well: some TV browsers report the same physical
+ * controls without setting mapping="standard". */
+static bool rwebinput_gamepad_button(
+      const EmscriptenGamepadEvent *gamepad, unsigned button)
+{
+   if (!gamepad || button >= (unsigned)gamepad->numButtons || button >= 64)
+      return false;
+
+   return gamepad->digitalButton[button]
+      || gamepad->analogButton[button] >= 0.5;
+}
+
+static bool rwebinput_gamepad_axis(
+      const EmscriptenGamepadEvent *gamepad, unsigned axis, double direction)
+{
+   double value;
+
+   if (!gamepad || axis >= (unsigned)gamepad->numAxes || axis >= 64)
+      return false;
+
+   value = gamepad->axis[axis];
+   return direction < 0.0
+      ? value < -RWEBINPUT_GAMEPAD_DEADZONE
+      : value > RWEBINPUT_GAMEPAD_DEADZONE;
+}
+
+static bool rwebinput_gamepad_dpad(
+      const EmscriptenGamepadEvent *gamepad, unsigned id)
+{
+   unsigned dpad_button = 12 + (id - RETRO_DEVICE_ID_JOYPAD_UP);
+   unsigned axis       = id <= RETRO_DEVICE_ID_JOYPAD_DOWN ? 1 : 0;
+   double direction    = (id == RETRO_DEVICE_ID_JOYPAD_UP ||
+         id == RETRO_DEVICE_ID_JOYPAD_LEFT) ? -1.0 : 1.0;
+
+   return rwebinput_gamepad_button(gamepad, dpad_button)
+      || rwebinput_gamepad_axis(gamepad, axis, direction);
+}
+
+static bool rwebinput_gamepad_button_for_retro(
+      const EmscriptenGamepadEvent *gamepad, unsigned id)
+{
+   static const unsigned standard_buttons[RWEBINPUT_GAMEPAD_BUTTONS] = {
+      0, 2, 8, 9, 12, 13, 14, 15, 1, 3, 4, 5, 6, 7, 10, 11
+   };
+
+   if (id >= RWEBINPUT_GAMEPAD_BUTTONS)
+      return false;
+   if (id >= RETRO_DEVICE_ID_JOYPAD_UP &&
+       id <= RETRO_DEVICE_ID_JOYPAD_RIGHT)
+      return rwebinput_gamepad_dpad(gamepad, id);
+
+   /* A number of TV browsers expose simple USB pads with only eight
+    * buttons. In that layout Select/Start are reported as buttons 6/7,
+    * while the browser-standard layout reports them as 8/9. Keep the
+    * standard mapping first and use the 6/7 fallback only for Select/Start
+    * on non-standard or short mappings. This avoids making shoulder
+    * buttons aliases on normal 12/16-button pads. */
+   if (id == RETRO_DEVICE_ID_JOYPAD_SELECT ||
+       id == RETRO_DEVICE_ID_JOYPAD_START)
+   {
+      unsigned standard = standard_buttons[id];
+      unsigned fallback = id == RETRO_DEVICE_ID_JOYPAD_SELECT ? 6 : 7;
+      bool nonstandard = strcmp((const char*)gamepad->mapping, "standard") != 0;
+
+      if (rwebinput_gamepad_button(gamepad, standard))
+         return true;
+      if ((nonstandard || gamepad->numButtons <= 8) &&
+          rwebinput_gamepad_button(gamepad, fallback))
+         return true;
+      return false;
+   }
+
+   return rwebinput_gamepad_button(gamepad, standard_buttons[id]);
+}
+
+static const EmscriptenGamepadEvent *rwebinput_gamepad_for_port(
+      const rwebinput_input_t *rwebinput, unsigned port)
+{
+   if (!rwebinput || port >= RWEBINPUT_MAX_GAMEPADS ||
+       !rwebinput->gamepads[port].connected)
+      return NULL;
+   return &rwebinput->gamepads[port];
+}
+
+static void rwebinput_gamepad_poll(rwebinput_input_t *rwebinput)
+{
+   int count;
+   int index;
+
+   memset(rwebinput->gamepads, 0, sizeof(rwebinput->gamepads));
+
+   /* This call refreshes the browser's Gamepad snapshot. On TV browsers
+    * without Gamepad API support it returns an error; keyboard/remote input
+    * continues normally in that case. */
+   if (emscripten_sample_gamepad_data() != EMSCRIPTEN_RESULT_SUCCESS)
+      return;
+
+   count = emscripten_get_num_gamepads();
+   count = MIN(count, RWEBINPUT_MAX_GAMEPADS);
+   for (index = 0; index < count; index++)
+   {
+      EmscriptenGamepadEvent *gamepad = &rwebinput->gamepads[index];
+      if (emscripten_get_gamepad_status(index, gamepad) != EMSCRIPTEN_RESULT_SUCCESS)
+         memset(gamepad, 0, sizeof(*gamepad));
+   }
+}
